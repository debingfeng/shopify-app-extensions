# ── 客户端（开发模式使用，生产环境由 public/conf/config.json 提供） ──
# shopify app的api key->client ID
NEXT_PUBLIC_SHOPIFY_API_KEY=
# 这里填写后端域名；本地代理模式固定为 /dev-proxy/proxy/api
# /dev-proxy 只允许用于本地开发，测试/生产环境必须配置真实业务后端 URL
# `shopify app dev` 场景下 rewrite 依赖 BACKEND_PORT，单独调试 local-proxy 时可回退 LOCAL_PROXY_PORT
NEXT_PUBLIC_BACKEND_API_BASE=/dev-proxy/proxy/api
# 这里填写 Shopify entry/callback 中台转发域名
NEXT_PUBLIC_PLATFORM_API_BASE=
# 这里填写 app 的名称（对应 entry/callback 路由中的 appName，也是平台侧注册的名称）
NEXT_PUBLIC_APP_NAME=
# 这里填写允许的 app origins
NEXT_PUBLIC_APP_ORIGINS=
#shopify app proxy 子路径（默认 bestrack）
NEXT_PUBLIC_SHOPIFY_APP_PROXY_SUBPATH=
# Sentry DSN（可选，用于前端错误监控）
NEXT_PUBLIC_SENTRY_DSN=

# ── 服务端（可选，覆盖 NEXT_PUBLIC_ 同名变量） ──
# SHOPIFY_API_KEY=
# BACKEND_API_BASE=
# PLATFORM_API_BASE=    # Shopify entry/callback 服务端转发目标；必填，不回退 BACKEND_API_BASE
# APP_NAME=
# APP_ORIGINS=
